## Day 29-31: Compose Navigation

### Create Navigation Graph

```kotlin
package com.example.fittrib.core.navigation

sealed class Screen(val route: String) {
    object Login : Screen("login")
    object Register : Screen("register")
    object ProfileWizard : Screen("profile_wizard/{userId}") {
        fun createRoute(userId: String) = "profile_wizard/$userId"
    }
    object Main : Screen("main")
    object Profile : Screen("profile")
    object EditProfile : Screen("edit_profile")
    object AddMeasurement : Screen("add_measurement")
    object Chart : Screen("chart")
    object FoodSearch : Screen("food_search")
    object Chat : Screen("chat/{otherUserId}") {
        fun createRoute(otherUserId: String) = "chat/$otherUserId"
    }
    object TribChat : Screen("trib_chat/{tribId}") {
        fun createRoute(tribId: String) = "trib_chat/$tribId"
    }
}

@Composable
fun FitTribNavGraph(
    navController: NavHostController,
    startDestination: String
) {
    NavHost(
        navController = navController,
        startDestination = startDestination
    ) {
        composable(Screen.Login.route) {
            LoginScreen(
                viewModel = hiltViewModel(),
                onLoginSuccess = {
                    navController.navigate(Screen.Main.route) {
                        popUpTo(Screen.Login.route) { inclusive = true }
                    }
                },
                onNavigateToRegister = {
                    navController.navigate(Screen.Register.route)
                }
            )
        }

        composable(
            route = Screen.Chat.route,
            arguments = listOf(navArgument("otherUserId") { type = NavType.StringType })
        ) { backStackEntry ->
            val otherUserId = backStackEntry.arguments?.getString("otherUserId")!!
            ChatScreen(
                viewModel = hiltViewModel(),
                otherUserName = "User Name",
                onBack = { navController.popBackStack() }
            )
        }
    }
}
```

