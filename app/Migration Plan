```kotlin
class MeasurementViewModel(
    private val repository: MeasurementRepository,
    private val userId: String
) : ViewModel() {

    private val _uiState = MutableStateFlow(MeasurementUiState())
    val uiState = _uiState.asStateFlow()

    init {
        loadMeasurements()
    }

    private fun loadMeasurements() {
        viewModelScope.launch {
            repository.getMeasurementsFlow(userId).collect { resource ->
                _uiState.value = when (resource) {
                    is Resource.Success -> _uiState.value.copy(
                        measurements = resource.data,
                        isLoading = false
                    )
                    is Resource.Error -> _uiState.value.copy(
                        error = resource.message,
                        isLoading = false
                    )
                    Resource.Loading -> _uiState.value.copy(isLoading = true)
                }
            }
        }
    }

    fun addMeasurement(measurement: BodyMeasurement) {
        viewModelScope.launch {
            repository.insertMeasurement(measurement)
        }
    }
}

data class MeasurementUiState(
    val measurements: List<BodyMeasurement> = emptyList(),
    val isLoading: Boolean = false,
    val error: String? = null
)
```

